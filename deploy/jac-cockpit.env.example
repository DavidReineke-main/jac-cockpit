# Copy to /etc/jac-cockpit.env, chmod 600, owner root.
# OAuth client of type "Web application" from Google Cloud Console, see docs/DEPLOY.md
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Long random string, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
COOKIE_SECURE=1
DB_PATH=/var/lib/jac-cockpit/cockpit.db
CACHE_SECONDS=300
# Read-only forum account for the attendance tracker, LOAs and patrol reports (not used yet)
FORUM_USER=
FORUM_PASSWORD=
